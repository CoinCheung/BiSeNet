def sha256_file(path):

    h = hashlib.sha256()

    with open(path, "rb") as f:

        for chunk in iter(
            lambda: f.read(1024 * 1024),
            b"",
        ):
            h.update(chunk)

    return h.hexdigest()


def split_from_path(path):

    parts = {
        p.lower()
        for p in Path(path).parts
    }

    if "train" in parts:
        return "train"

    if (
        "valid" in parts
        or "validation" in parts
        or "val" in parts
    ):
        return "val"

    raise RuntimeError(
        f"Cannot determine YCOR split: {path}"
    )


class YCORExternalDataset(Dataset):

    def __init__(
        self,
        data_root,
        manifest,
        mean,
        std,
    ):

        self.data_root = Path(
            data_root
        ).resolve()

        self.manifest = Path(
            manifest
        ).resolve()

        self.mean = torch.tensor(
            mean,
            dtype=torch.float32,
        )[:, None, None]

        self.std = torch.tensor(
            std,
            dtype=torch.float32,
        )[:, None, None]

        lines = [
            line.strip()
            for line in
            self.manifest.read_text().splitlines()
            if line.strip()
        ]

        self.samples = []

        for line in lines:

            parts = line.split(
                maxsplit=1
            )

            if len(parts) != 2:

                raise RuntimeError(
                    f"Bad manifest line: {line}"
                )

            rgb_rel, label_rel = parts

            rgb = (
                self.data_root /
                rgb_rel
            )

            label = (
                self.data_root /
                label_rel
            )

            if not rgb.is_file():
                raise FileNotFoundError(
                    rgb
                )

            if not label.is_file():
                raise FileNotFoundError(
                    label
                )

            split = split_from_path(
                rgb_rel
            )

            self.samples.append(
                (
                    rgb_rel,
                    label_rel,
                    split,
                )
            )

    def __len__(self):

        return len(
            self.samples
        )

    def __getitem__(self, idx):

        (
            rgb_rel,
            label_rel,
            split,
        ) = self.samples[idx]

        rgb_path = (
            self.data_root /
            rgb_rel
        )

        label_path = (
            self.data_root /
            label_rel
        )

        # Match BaseDataset.get_image():
        # OpenCV BGR -> RGB.
        image = cv2.imread(
            str(rgb_path),
            cv2.IMREAD_COLOR,
        )

        if image is None:
            raise RuntimeError(
                f"Could not read RGB: {rgb_path}"
            )

        image = (
            image[
                :,
                :,
                ::-1
            ]
            .copy()
        )

        if image.shape != (
            ORIG_H,
            ORIG_W,
            3,
        ):
            raise RuntimeError(
                f"Unexpected image shape "
                f"{image.shape}: {rgb_path}"
            )

        # IMPORTANT:
        # Preserve P-mode raw class indices.
        with Image.open(
            label_path
        ) as im:

            if im.mode != "P":
                raise RuntimeError(
                    f"Expected P-mode label, "
                    f"got {im.mode}: {label_path}"
                )

            raw_label = np.asarray(
                im,
                dtype=np.uint8,
            )

        if raw_label.shape != (
            ORIG_H,
            ORIG_W,
        ):
            raise RuntimeError(
                f"Unexpected label shape "
                f"{raw_label.shape}: {label_path}"
            )

        observed = set(
            np.unique(
                raw_label
            ).tolist()
        )

        unknown = (
            observed
            - set(
                SOURCE_TO_TARGET
            )
        )

        if unknown:

            raise RuntimeError(
                f"Unknown YCOR indices "
                f"{sorted(unknown)}: "
                f"{label_path}"
            )

        target = TARGET_LUT[
            raw_label
        ]

        # RGB float tensor in exactly the same channel
        # convention as the existing RUGD evaluator.
        image = (
            image
            .transpose(
                2,
                0,
                1,
            )
            .astype(
                np.float32
            )
        )

        image = (
            torch.from_numpy(
                image
            )
            .div_(255.0)
        )

        image = (
            image
            .sub(
                self.mean
            )
            .div(
                self.std
            )
            .clone()
        )

        target = torch.from_numpy(
            target.astype(
                np.int64
            )
        )

        return (
            image,
            target,
            split,
            rgb_rel,
        )


def preprocess_canvas(images):

    """
    Native normalized tensor:
        N x 3 x 544 x 1024

    ->
        aspect preserving resize
        N x 3 x 374 x 704

    ->
        zero padding in NORMALIZED tensor space
        top=101, bottom=101

    ->
        N x 3 x 576 x 704
    """

    if tuple(
        images.shape[-2:]
    ) != (
        ORIG_H,
        ORIG_W,
    ):

        raise RuntimeError(
            f"Unexpected native tensor size: "
            f"{images.shape[-2:]}"
        )

    images = F.interpolate(
        images,
        size=(
            RESIZE_H,
            RESIZE_W,
        ),
        mode="bilinear",
        align_corners=True,
    )

    images = F.pad(
        images,
        (
            0,
            0,
            PAD_TOP,
            PAD_BOTTOM,
        ),
        mode="constant",
        value=0.0,
    )

    if tuple(
        images.shape[-2:]
    ) != (
        CANVAS_H,
        CANVAS_W,
    ):

        raise RuntimeError(
            f"Bad canvas shape: "
            f"{images.shape[-2:]}"
        )

    return images


def restore_logits_to_native(
    logits,
):

    if tuple(
        logits.shape[-2:]
    ) != (
        CANVAS_H,
        CANVAS_W,
    ):

        raise RuntimeError(
            "Model output does not match "
            "frozen YCOR canvas. "
            f"Observed={tuple(logits.shape[-2:])}, "
            f"expected={(CANVAS_H, CANVAS_W)}"
        )

    # Remove padding BEFORE resizing.
    logits = logits[
        :,
        :,
        PAD_TOP:
            PAD_TOP + RESIZE_H,
        :,
    ]

    if tuple(
        logits.shape[-2:]
    ) != (
        RESIZE_H,
        RESIZE_W,
    ):

        raise RuntimeError(
            f"Bad cropped-logit shape: "
            f"{logits.shape[-2:]}"
        )

    logits = F.interpolate(
        logits,
        size=(
            ORIG_H,
            ORIG_W,
        ),
        mode="bilinear",
        align_corners=True,
    )

    return logits


def semantic_boundary(
    mask,
    valid,
    mode,
):

    edge = np.zeros(
        mask.shape,
        dtype=np.bool_,
    )

    left = mask[
        :,
        :-1
    ]

    right = mask[
        :,
        1:
    ]

    pair_valid = (
        valid[:, :-1]
        &
        valid[:, 1:]
    )

    if mode == "all":

        difference = (
            left != right
        ) & pair_valid

    elif mode == "traversability":

        difference = (
            (
                (left == 1)
                &
                (right == 2)
            )
            |
            (
                (left == 2)
                &
                (right == 1)
            )
        ) & pair_valid

    else:

        raise ValueError(
            mode
        )

    edge[:, :-1] |= difference
    edge[:, 1:] |= difference

    top = mask[
        :-1,
        :
    ]

    bottom = mask[
        1:,
        :
    ]

    pair_valid = (
        valid[:-1, :]
        &
        valid[1:, :]
    )

    if mode == "all":

        difference = (
            top != bottom
        ) & pair_valid

    else:

        difference = (
            (
                (top == 1)
                &
                (bottom == 2)
            )
            |
            (
                (top == 2)
                &
                (bottom == 1)
            )
        ) & pair_valid

    edge[:-1, :] |= difference
    edge[1:, :] |= difference

    edge &= valid

    return edge


def dilation(
    edge,
    tolerance,
):

    if tolerance <= 0:
        return edge

    size = (
        2 * tolerance
        + 1
    )

    kernel = (
        cv2.getStructuringElement(
            cv2.MORPH_ELLIPSE,
            (
                size,
                size,
            ),
        )
    )

    dilated = cv2.dilate(
        edge.astype(
            np.uint8
        ),
        kernel,
        iterations=1,
    )

    return dilated.astype(
        bool
    )


class BoundaryMetric:

    def __init__(
        self,
        tolerance,
    ):

        self.tolerance = (
            tolerance
        )

        self.pred_total = 0
        self.gt_total = 0

        self.pred_matched = 0
        self.gt_matched = 0

    def update(
        self,
        pred_edge,
        gt_edge,
    ):

        pred_dilated = dilation(
            pred_edge,
            self.tolerance,
        )

        gt_dilated = dilation(
            gt_edge,
            self.tolerance,
        )

        self.pred_total += int(
            pred_edge.sum()
        )

        self.gt_total += int(
            gt_edge.sum()
        )

        self.pred_matched += int(
            (
                pred_edge
                &
                gt_dilated
            ).sum()
        )

        self.gt_matched += int(
            (
                gt_edge
                &
                pred_dilated
            ).sum()
        )

    def compute(self):

        precision = (
            self.pred_matched
            /
            max(
                self.pred_total,
                1,
            )
        )

        recall = (
            self.gt_matched
            /
            max(
                self.gt_total,
                1,
            )
        )

        f1 = (
            2
            * precision
            * recall
            /
            max(
                precision
                + recall,
                1e-12,
            )
        )

        return {
            "precision":
                precision,

            "recall":
                recall,

            "f1":
                f1,

            "pred_pixels":
                self.pred_total,

            "gt_pixels":
                self.gt_total,
        }


class MetricAccumulator:

    def __init__(
        self,
        tolerances,
    ):

        self.images = 0

        self.total_pixels = 0
        self.valid_pixels = 0
        self.ignore_pixels = 0

        self.confusion = np.zeros(
            (
                NUM_CLASSES,
                NUM_CLASSES,
            ),
            dtype=np.int64,
        )

        self.boundary = {}

        for tolerance in tolerances:

            self.boundary[
                tolerance
            ] = {
                "all":
                    BoundaryMetric(
                        tolerance
                    ),

                "traversability":
                    BoundaryMetric(
                        tolerance
                    ),
            }

    def update(
        self,
        prediction,
        target,
    ):

        self.images += 1

        self.total_pixels += int(
            target.size
        )

        valid = (
            (target != IGNORE_INDEX)
            &
            (target >= 0)
            &
            (target < NUM_CLASSES)
        )

        n_valid = int(
            valid.sum()
        )

        self.valid_pixels += (
            n_valid
        )

        self.ignore_pixels += int(
            target.size
            - n_valid
        )

        t = target[
            valid
        ].astype(
            np.int64
        )

        p = prediction[
            valid
        ].astype(
            np.int64
        )

        indices = (
            t
            * NUM_CLASSES
            + p
        )

        self.confusion += (
            np.bincount(
                indices,
                minlength=(
                    NUM_CLASSES
                    * NUM_CLASSES
                ),
            )
            .reshape(
                NUM_CLASSES,
                NUM_CLASSES,
            )
        )

        pred_all = semantic_boundary(
            prediction,
            valid,
            mode="all",
        )

        gt_all = semantic_boundary(
            target,
            valid,
            mode="all",
        )

        pred_trav = semantic_boundary(
            prediction,
            valid,
            mode="traversability",
        )

        gt_trav = semantic_boundary(
            target,
            valid,
            mode="traversability",
        )

        for _, metrics in (
            self.boundary.items()
        ):

            metrics[
                "all"
            ].update(
                pred_all,
                gt_all,
            )

            metrics[
                "traversability"
            ].update(
                pred_trav,
                gt_trav,
            )

    def compute(self):

        confusion = (
            self.confusion
            .astype(
                np.float64
            )
        )

        tp = np.diag(
            confusion
        )

        fp = (
            confusion.sum(
                axis=0
            )
            - tp
        )

        fn = (
            confusion.sum(
                axis=1
            )
            - tp
        )

        # Reproduce the existing RUGD3 evaluator's
        # +1 denominator convention.
        iou = (
            tp
            /
            (
                tp
                + fp
                + fn
                + 1.0
            )
        )

        precision = (
            tp
            /
            (
                tp
                + fp
                + 1.0
            )
        )

        recall = (
            tp
            /
            (
                tp
                + fn
                + 1.0
            )
        )

        f1 = (
            2
            * precision
            * recall
            /
            np.maximum(
                precision
                + recall,
                1e-12,
            )
        )

        boundary_result = {}

        for (
            tolerance,
            metrics,
        ) in self.boundary.items():

            boundary_result[
                str(tolerance)
            ] = {
                "all":
                    metrics[
                        "all"
                    ].compute(),

                "traversability":
                    metrics[
                        "traversability"
                    ].compute(),
            }

        return {
            "images":
                self.images,

            "total_pixels":
                self.total_pixels,

            "valid_pixels":
                self.valid_pixels,

            "ignore_pixels":
                self.ignore_pixels,

            "coverage":
                (
                    self.valid_pixels
                    /
                    max(
                        self.total_pixels,
                        1,
                    )
                ),

            "confusion":
                self.confusion.tolist(),

            "iou":
                iou.tolist(),

            "precision":
                precision.tolist(),

            "recall":
                recall.tolist(),

            "f1":
                f1.tolist(),

            "miou":
                float(
                    iou.mean()
                ),

            "macro_f1":
                float(
                    f1.mean()
                ),

            "boundary":
                boundary_result,
        }


def load_checkpoint_manifest(
    path,
):

    records = json.loads(
        Path(path).read_text()
    )

    if len(records) != 9:
        raise RuntimeError(
            f"Expected 9 frozen records, "
            f"found {len(records)}"
        )

    return records


def find_checkpoint_record(
    records,
    model_name,
    seed,
):

    matches = [
        r
        for r in records
        if (
            r["model"]
            == model_name
            and int(
                r["seed"]
            )
            == int(seed)
        )
    ]

    if len(matches) != 1:

        raise RuntimeError(
            f"Checkpoint lookup failed: "
            f"{model_name} seed{seed}"
        )

    return matches[0]


def load_model(
    model_name,
    seed,
    manifest_path,
    device,
):

    records = (
        load_checkpoint_manifest(
            manifest_path
        )
    )

    record = (
        find_checkpoint_record(
            records,
            model_name,
            seed,
        )
    )

    spec = MODEL_SPECS[
        model_name
    ]

    path = Path(
        record[
            "eval_path"
        ]
    )

    observed_sha = (
        sha256_file(
            path
        )
    )

    expected_sha = (
        record[
            "eval_file_sha256"
        ]
    )

    if observed_sha != expected_sha:

        raise RuntimeError(
            "Checkpoint SHA256 mismatch:\n"
            f"{path}\n"
            f"expected={expected_sha}\n"
            f"observed={observed_sha}"
        )

    model = model_factory[
        spec[
            "model_type"
        ]
    ](
        NUM_CLASSES
    )

    checkpoint = torch.load(
        path,
        map_location="cpu",
        weights_only=False,
    )

    if (
        isinstance(
            checkpoint,
            dict,
        )
        and "model"
        in checkpoint
        and isinstance(
            checkpoint["model"],
            dict,
        )
    ):
        checkpoint = checkpoint[
            "model"
        ]

    # Never relax this.
    model.load_state_dict(
        checkpoint,
        strict=True,
    )

    if hasattr(
        model,
        "aux_mode",
    ):
        model.aux_mode = "eval"

    model.to(
        device
    )

    model.eval()

    return (
        model,
        record,
    )


def parse_qualitative_list(
    path,
):

    if path is None:
        return set()

    path = Path(path)

    if not path.is_file():
        raise FileNotFoundError(
            path
        )

    out = set()

    for line in (
        path.read_text()
        .splitlines()
    ):

        line = line.strip()

        if not line:
            continue

        rgb_rel = line.split(
            maxsplit=1
        )[0]

        out.add(
            rgb_rel
        )

    return out



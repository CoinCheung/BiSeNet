def run_evaluation(
    args,
):

    if args.model is None:
        raise RuntimeError(
            "--model is required"
        )

    if args.seed is None:
        raise RuntimeError(
            "--seed is required"
        )

    if args.output_dir is None:
        raise RuntimeError(
            "--output-dir is required"
        )

    if not torch.cuda.is_available():
        raise RuntimeError(
            "CUDA unavailable"
        )

    spec = MODEL_SPECS[
        args.model
    ]

    device = torch.device(
        "cuda"
    )

    dataset = YCORExternalDataset(
        args.data_root,
        args.manifest,
        spec["mean"],
        spec["std"],
    )

    loader = DataLoader(
        dataset,
        batch_size=args.batch_size,
        shuffle=False,
        drop_last=False,
        num_workers=args.workers,
        pin_memory=True,
    )

    model, ckpt_record = (
        load_model(
            args.model,
            args.seed,
            args.checkpoint_manifest,
            device,
        )
    )

    tolerances = [
        2,
        3,
        5,
    ]

    metrics = {
        "all":
            MetricAccumulator(
                tolerances
            ),

        "train":
            MetricAccumulator(
                tolerances
            ),

        "val":
            MetricAccumulator(
                tolerances
            ),
    }

    qualitative = (
        parse_qualitative_list(
            args.qualitative_list
        )
    )

    output_dir = Path(
        args.output_dir
    )

    output_dir.mkdir(
        parents=True,
        exist_ok=True,
    )

    prediction_dir = (
        output_dir /
        "qualitative_predictions"
    )

    if qualitative:
        prediction_dir.mkdir(
            parents=True,
            exist_ok=True,
        )

    with torch.no_grad():

        for (
            images,
            labels,
            splits,
            rel_paths,
        ) in tqdm(
            loader,
            desc=(
                f"{args.model} "
                f"seed{args.seed}"
            ),
        ):

            images = images.cuda(
                non_blocking=True
            )

            canvas = (
                preprocess_canvas(
                    images
                )
            )

            outputs = model(
                canvas
            )

            if isinstance(
                outputs,
                (
                    tuple,
                    list,
                ),
            ):
                logits = outputs[0]
            else:
                logits = outputs

            logits = (
                restore_logits_to_native(
                    logits
                )
            )

            predictions = (
                torch.argmax(
                    logits,
                    dim=1,
                )
                .cpu()
                .numpy()
            )

            targets = (
                labels
                .numpy()
            )

            for index in range(
                len(
                    predictions
                )
            ):

                pred = (
                    predictions[
                        index
                    ]
                )

                target = (
                    targets[
                        index
                    ]
                )

                split = (
                    splits[
                        index
                    ]
                )

                rel_path = (
                    rel_paths[
                        index
                    ]
                )

                metrics[
                    "all"
                ].update(
                    pred,
                    target,
                )

                metrics[
                    split
                ].update(
                    pred,
                    target,
                )

                if (
                    rel_path
                    in qualitative
                ):

                    safe_name = (
                        rel_path
                        .replace(
                            "/",
                            "__",
                        )
                    )

                    safe_name = (
                        str(
                            Path(
                                safe_name
                            )
                            .with_suffix(
                                ".png"
                            )
                        )
                    )

                    Image.fromarray(
                        pred.astype(
                            np.uint8
                        ),
                        mode="L",
                    ).save(
                        prediction_dir /
                        safe_name
                    )

    computed = {
        subset:
            accumulator.compute()
        for (
            subset,
            accumulator
        ) in metrics.items()
    }

    # --------------------------------------------------------
    # Strict YCOR-All integrity checks
    # --------------------------------------------------------

    if (
        Path(
            args.manifest
        ).name
        == "ycor_all.lst"
    ):

        all_result = (
            computed[
                "all"
            ]
        )

        if (
            all_result[
                "images"
            ]
            != EXPECTED_ALL_IMAGES
        ):
            raise RuntimeError(
                "YCOR-All image count mismatch"
            )

        if (
            computed[
                "train"
            ][
                "images"
            ]
            != EXPECTED_TRAIN_IMAGES
        ):
            raise RuntimeError(
                "YCOR train image count mismatch"
            )

        if (
            computed[
                "val"
            ][
                "images"
            ]
            != EXPECTED_VAL_IMAGES
        ):
            raise RuntimeError(
                "YCOR val image count mismatch"
            )

        if (
            all_result[
                "total_pixels"
            ]
            != EXPECTED_TOTAL_PIXELS
        ):
            raise RuntimeError(
                "YCOR total pixel count mismatch"
            )

        if (
            all_result[
                "valid_pixels"
            ]
            != EXPECTED_VALID_PIXELS
        ):
            raise RuntimeError(
                "YCOR valid pixel count mismatch"
            )

        if (
            all_result[
                "ignore_pixels"
            ]
            != EXPECTED_IGNORE_PIXELS
        ):
            raise RuntimeError(
                "YCOR ignore pixel count mismatch"
            )

        if (
            sum(
                sum(row)
                for row in
                all_result[
                    "confusion"
                ]
            )
            != EXPECTED_VALID_PIXELS
        ):
            raise RuntimeError(
                "Confusion matrix valid-pixel "
                "sum mismatch"
            )

    result = {
        "dataset":
            "YCOR",

        "manifest":
            str(
                Path(
                    args.manifest
                ).resolve()
            ),

        "model":
            args.model,

        "seed":
            int(
                args.seed
            ),

        "best_iter":
            int(
                ckpt_record[
                    "best_iter"
                ]
            ),

        "checkpoint":
            ckpt_record[
                "eval_path"
            ],

        "checkpoint_sha256":
            ckpt_record[
                "eval_file_sha256"
            ],

        "model_type":
            spec[
                "model_type"
            ],

        "normalization": {
            "mean":
                list(
                    spec[
                        "mean"
                    ]
                ),

            "std":
                list(
                    spec[
                        "std"
                    ]
                ),
        },

        "geometry": {
            "original_hw":
                [
                    ORIG_H,
                    ORIG_W,
                ],

            "resized_hw":
                [
                    RESIZE_H,
                    RESIZE_W,
                ],

            "padding_ltrb":
                [
                    0,
                    PAD_TOP,
                    0,
                    PAD_BOTTOM,
                ],

            "canvas_hw":
                [
                    CANVAS_H,
                    CANVAS_W,
                ],

            "input_interpolation":
                "bilinear_align_corners_true",

            "padding_space":
                "normalized_tensor",

            "padding_value":
                0.0,

            "logit_inverse_interpolation":
                "bilinear_align_corners_true",
        },

        "inference": {
            "single_scale":
                True,

            "flip":
                False,

            "tta":
                False,

            "amp":
                False,

            "batch_size":
                args.batch_size,
        },

        "subsets":
            computed,
    }

    result_path = (
        output_dir /
        "metrics.json"
    )

    result_path.write_text(
        json.dumps(
            result,
            indent=2,
        )
        + "\n"
    )

    for subset in [
        "all",
        "train",
        "val",
    ]:

        print_subset(
            subset,
            computed[
                subset
            ],
        )

    print()
    print(
        "RESULT JSON:"
    )

    print(
        result_path
    )



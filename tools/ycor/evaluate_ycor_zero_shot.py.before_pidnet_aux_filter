            NUM_CLASSES,
            CANVAS_H,
            CANVAS_W,
        )

        if tuple(
            logits.shape
        ) != expected:

            raise RuntimeError(
                f"{model_name} seed{seed}: "
                f"logit shape={tuple(logits.shape)}, "
                f"expected={expected}"
            )

        print(
            f"PASS "
            f"{model_name:<9} "
            f"seed={seed} "
            f"best={loaded_record['best_iter']} "
            f"output={tuple(logits.shape)}"
        )

        del logits
        del outputs
        del x
        del model

        torch.cuda.empty_cache()

    print()
    print(
        "ALL 9 SYNTHETIC MODEL SMOKE TESTS PASSED"
    )



def file_sha256(path):
    h = hashlib.sha256()

    with open(path, "rb") as f:
        for chunk in iter(
            lambda: f.read(1024 * 1024),
            b"",
        ):
            h.update(chunk)

    return h.hexdigest()


def tensor_dict_score(d):
    if not isinstance(d, dict):
        return -1

    score = 0

    for _, v in d.items():
        if torch.is_tensor(v):
            score += 1

    return score


def find_state_dict(obj):
    """
    Find the model state_dict without assuming a single
    checkpoint serialization format.
    """

    if not isinstance(obj, dict):
        raise RuntimeError(
            f"Checkpoint root is not dict: {type(obj)}"
        )

    preferred = [
        "model",
        "state_dict",
        "model_state_dict",
        "net",
        "network",
    ]

    for key in preferred:
        v = obj.get(key)

        if (
            isinstance(v, dict)
            and tensor_dict_score(v) > 10
        ):
            return v

    if tensor_dict_score(obj) > 10:
        return obj

    candidates = []

    for key, value in obj.items():

        if not isinstance(value, dict):
            continue

        if key.lower() in {
            "optimizer",
            "optim",
            "scheduler",
            "lr_scheduler",
        }:
            continue

        score = tensor_dict_score(value)

        if score > 10:
            candidates.append(
                (
                    score,
                    key,
                    value,
                )
            )

    if not candidates:
        raise RuntimeError(
            "Could not locate model state_dict. "
            f"Root keys={list(obj.keys())}"
        )

    candidates.sort(
        key=lambda x: x[0],
        reverse=True,
    )

    return candidates[0][2]


def normalize_key(k):
    prefixes = [
        "module.",
    ]

    changed = True

    while changed:
        changed = False

        for prefix in prefixes:
            if k.startswith(prefix):
                k = k[len(prefix):]
                changed = True

    return k


def state_signature(path):
    obj = torch.load(
        path,
        map_location="cpu",
        weights_only=False,
    )

    state = find_state_dict(obj)

    normalized = {}

    for key, value in state.items():

        if not torch.is_tensor(value):
            continue

        key = normalize_key(
            str(key)
        )

        normalized[key] = value

    h = hashlib.sha256()

    for key in sorted(normalized):

        t = (
            normalized[key]
            .detach()
            .cpu()
            .contiguous()
        )

        h.update(
            key.encode("utf-8")
        )

        h.update(
            str(t.dtype).encode("utf-8")
        )

        h.update(
            str(tuple(t.shape)).encode("utf-8")
        )

        raw = (
            t.view(torch.uint8)
            .numpy()
            .tobytes()
        )

        h.update(raw)

    return (
        h.hexdigest(),
        len(normalized),
    )


def iter_from_path(path):
    m = re.search(
        r"checkpoint_iter_(\d+)\.pth$",
        path.name,
    )

    if not m:
        return None

    return int(
        m.group(1)
    )


